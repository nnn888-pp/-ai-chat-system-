# 数据库（开发默认 SQLite，切换 MySQL 只需改这一行）
DATABASE_URL=sqlite:///./app.db

# JWT
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# 本地密码预处理（前端 SHA256 后再提交，后端再 bcrypt）
SHA256_SALT=static-salt-change-me

# 远端模型示例（OpenAI 兼容协议）
REMOTE_MODELS_JSON=[
  {"key":"remote:deepseek","name":"DeepSeek Chat","kind":"remote","base_url":"https://api.deepseek.com/v1","api_key":"sk-your-key","model":"deepseek-chat"},
  {"key":"remote:zhipu","name":"智谱 GLM-4","kind":"remote","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"sk-your-key","model":"glm-4"}
]

# 本地模型目录（放自己的模型）
LOCAL_MODELS_DIR=../models_store
